# Copy to .env and adjust. Values already present in the environment win.

APP_ENV=development
ADDR=:8080

# Canonical origin. Every QR code encodes BASE_URL/<slug>, so changing this
# after printing invalidates existing codes. Must be https:// in production.
BASE_URL=http://localhost:8080

DATABASE_PATH=data/app.db

# Required in production. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Used only to create the very first admin account, when no user exists.
ADMIN_BOOTSTRAP_EMAIL=office@traveldoor.ge
ADMIN_BOOTSTRAP_PASSWORD=change-me-at-least-10-chars

UPLOAD_DIR=uploads

# Import the bundled Travel Door Georgia profile on every start. The import is
# idempotent and keeps the slug, so printed QR codes stay valid.
SEED_DEFAULT=false
